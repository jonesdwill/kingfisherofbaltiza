---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const reports = await getCollection('trip-reports');
  return reports.map((report) => ({
    params: { slug: report.id },
    props: report,
  }));
}

type Props = CollectionEntry<'trip-reports'>;

const report = Astro.props;
const { Content, headings } = await render(report);
const toc = headings.filter((h) => h.depth <= 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${report.data.title} | Kingfisher of Baltiza`} description={report.data.description} />
  </head>
  <body class="page-body">
    <Header />

    <main class="page-shell">
      <article class="story-panel">
        {report.data.heroImage && (
          <div class="cover-image">
            <img src={report.data.heroImage} alt={report.data.title} />
          </div>
        )}
        <p class="eyebrow">Trip Report</p>
        <h1>{report.data.title}</h1>
        <p class="meta"><FormattedDate date={report.data.pubDate} /></p>
        <dl class="credits">
          {report.data.expeditionDates && (<><dt>Expedition</dt><dd>{report.data.expeditionDates}</dd></>)}
          {report.data.authors && (<><dt>Authors</dt><dd>{report.data.authors}</dd></>)}
          {report.data.team && (<><dt>Expedition Team Members</dt><dd>{report.data.team}</dd></>)}
        </dl>
        {report.data.pdf && (
          <p class="pdf-note">
            A compressed, formatted PDF is available to download below. Please reach out for a high-quality one with full sized images (1.3GBs).
          </p>
          <p>
            <a class="download" href={report.data.pdf} download>
              Download PDF{report.data.pdfSize ? ` (${report.data.pdfSize})` : ''}
            </a>
          </p>
        )}
        <nav class="toc" aria-label="Contents">
          <h2>Contents</h2>
          <ul>
            {toc.map((h) => (
              <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
        <div class="report-body">
          <Content />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  :root {
    --bg: #f5f1eb;
    --ink: #171717;
    --muted: #5f5c58;
  }

  html {
    background: var(--bg);
  }

  body.page-body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Helvetica Neue', Arial, sans-serif;
  }

  a {
    color: var(--ink);
  }

  .page-shell {
    width: min(1100px, calc(100% - 3rem));
    margin: 0 auto;
    padding: 0.75rem 0 4rem;
  }

  .story-panel {
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  .cover-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin: 0 0 1.5rem;
  }

  .cover-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.06em;
    text-transform: uppercase;
    font-weight: 800;
  }

  .meta {
    margin: 0.75rem 0 1.25rem;
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .download {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--ink);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .download:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .report-body :global(p),
  .report-body :global(li) {
    font-size: 1.02rem;
    line-height: 1.8;
  }

  .report-body :global(h2) {
    margin: 3.5rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(23, 23, 23, 0.15);
    font-size: 1.8rem;
    letter-spacing: -0.03em;
  }

  .report-body :global(h3) {
    margin: 2.25rem 0 0.5rem;
    font-size: 1.25rem;
  }

  .report-body :global(h4) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.05rem;
  }

  .pdf-note {
    max-width: 60ch;
    color: var(--muted);
    line-height: 1.6;
  }

  .credits {
    margin: 0 0 1.5rem;
    line-height: 1.7;
  }

  .credits dt {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.6rem;
  }

