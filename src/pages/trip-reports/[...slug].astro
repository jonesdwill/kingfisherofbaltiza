---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const reports = await getCollection('trip-reports');
  return reports.map((report) => ({
    params: { slug: report.id },
    props: report,
  }));
}

type Props = CollectionEntry<'trip-reports'>;

const report = Astro.props;
const { Content, headings } = await render(report);
const toc = headings.filter((h) => h.depth <= 3);
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" />
    <BaseHead title={`${report.data.title} | Kingfisher of Baltiza`} description={report.data.description} />
  </head>
  <body class="page-body">
    <Header />

    <main class="page-shell">
      <article class="story-panel">
        {report.data.heroImage && (
          <div class="cover-image">
            <img src={report.data.heroImage} alt={report.data.title} />
          </div>
        )}
        <p class="eyebrow">Trip Report</p>
        <h1>{report.data.title}</h1>
        <p class="meta"><FormattedDate date={report.data.pubDate} /></p>
        <dl class="credits">
          {report.data.expeditionDates && (<><dt>Expedition</dt><dd>{report.data.expeditionDates}</dd></>)}
          {report.data.authors && (<><dt>Authors</dt><dd>{report.data.authors}</dd></>)}
          {report.data.team && (<><dt>Expedition Team Members</dt><dd>{report.data.team}</dd></>)}
        </dl>
        {report.data.pdf && (
          <p class="pdf-note">
            A compressed, formatted PDF is available to download below. Please reach out for a high-quality one with full sized images (1.3GBs).
          </p>
          <p>
            <a class="download" href={report.data.pdf} download>
              Download PDF{report.data.pdfSize ? ` (${report.data.pdfSize})` : ''}
            </a>
          </p>
        )}
        <nav class="toc" aria-label="Contents">
          <h2>Contents</h2>
          <ul>
            {toc.map((h) => (
              <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
        <div class="report-body">
          <Content />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  :root {
    --bg: #f5f1eb;
    --ink: #171717;
    --muted: #5f5c58;
  }

  html {
    background: var(--bg);
  }

  body.page-body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Helvetica Neue', Arial, sans-serif;
  }

  a {
    color: var(--ink);
  }

  .page-shell {
    width: min(1100px, calc(100% - 3rem));
    max-width: none;
    margin: 0 auto;
    padding: 0.75rem 0 4rem;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  .page-shell :global(h1),
  .page-shell :global(h2),
  .page-shell :global(h3),
  .page-shell :global(h4) {
    font-family: Inter, sans-serif;
    font-weight: 600;
    color: #1a1a1a;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .page-shell :global(h1) {
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .page-shell :global(p) {
    margin: 1em 0;
  }

  .page-shell :global(a) {
    color: #1a1a1a;
    text-decoration: none;
  }

  .page-shell :global(.toc li) {
    margin: 0;
  }

  .story-panel {
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  .cover-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin: 0 0 1.5rem;
  }

  .cover-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.06em;
    text-transform: uppercase;
    font-weight: 800;
  }

  .meta {
    margin: 0.75rem 0 1.25rem;
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .download {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--ink);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .download:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .report-body :global(p),
  .report-body :global(li) {
    font-size: 1.02rem;
    line-height: 1.8;
  }

  .report-body :global(h2) {
    margin: 3.5rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(23, 23, 23, 0.15);
    font-size: 1.8rem;
    letter-spacing: -0.03em;
  }

  .report-body :global(h3) {
    margin: 2.25rem 0 0.5rem;
    font-size: 1.25rem;
  }

  .report-body :global(h4) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.05rem;
  }

  .pdf-note {
    max-width: 60ch;
    color: var(--muted);
    line-height: 1.6;
  }

  .credits {
    margin: 0 0 1.5rem;
    line-height: 1.7;
  }

  .credits dt {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.6rem;
  }

  .credits dd {
    margin: 0;
  }

  .toc {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(23, 23, 23, 0.15);
  }

  .toc h2 {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2 320px;
    column-gap: 2rem;
  }

  .toc li {
    break-inside: avoid;
    text-transform: none;
    letter-spacing: normal;
    list-style: none;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .toc li.depth-2 {
    margin-top: 0.5rem;
    font-weight: 700;
  }

  .toc li.depth-3 {
    padding-left: 1rem;
  }

  .toc a {
    text-transform: none;
    letter-spacing: normal;
    font-size: inherit;
    font-weight: inherit;
  }

  .report-body :global(figure) {
    margin: 1.75rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .report-body :global(img) {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    max-height: 70vh;
    width: auto;
    height: auto;
  }

  /* Side-by-side images share a height: each column's width is proportional to its aspect ratio. */
  .report-body :global(figure:has(.minipage)) {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .report-body :global(.minipage) {
    flex: var(--ar, 1) 1 0;
    min-width: 0;
    display: block;
  }

  .report-body :global(.minipage p) {
    text-align: center;
  }

  .report-body :global(.minipage img) {
    width: 100%;
    max-height: none;
  }

  .report-body :global(figcaption),
  .report-body :global(figure > p) {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .report-body :global(.bio) {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 1.25rem;
    align-items: start;
    margin: 1.5rem 0;
  }

  .report-body :global(.bio figure) {
    margin: 0;
  }

  .report-body :global(.bio p) {
    margin: 0;
  }

  .report-body :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.85rem;
    margin: 1.5rem 0;
  }

  .report-body :global(th),
  .report-body :global(td) {
    padding: 0.35rem 0.6rem;
    border-bottom: 1px solid rgba(23, 23, 23, 0.12);
    text-align: left;
    vertical-align: top;
  }

  .report-body :global(embed) {
    width: 80%;
    height: 600px;
  }

  @media (max-width: 760px) {
    .page-shell {
      width: min(100vw - 1.25rem, 100%);
    }

    .report-body :global(.bio) {
      grid-template-columns: 1fr;
    }

  }
</style>
